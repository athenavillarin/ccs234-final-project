# copy this file to .env and fill in real values; never commit .env

# network scan settings
SCAN_RANGE=
PING_COUNT=4
PING_TIMEOUT_MS=1000
SCAN_THREADS=64

# local database file
DB_PATH=data/history.db

# email notifications (smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# optional cloud database
CLOUD_DB_URL=
CLOUD_DB_KEY=
